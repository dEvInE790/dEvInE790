# Public URL of the deployed site (used for SEO metadata, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Enquiry delivery ────────────────────────────────────────────────
# Quote requests and contact enquiries are emailed to this inbox.
# Until ENQUIRY_TO_EMAIL plus ONE delivery method below is configured, the
# forms tell visitors honestly that online submission isn't available yet
# and offer to send the same enquiry by WhatsApp instead.
ENQUIRY_TO_EMAIL=

# Option A — SMTP (works with Gmail/Google Workspace using an App Password,
# Zoho Mail, or your hosting provider's mailbox)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER
SMTP_FROM=

# Option B — Resend (https://resend.com). Used if RESEND_API_KEY is set.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend
RESEND_FROM=
