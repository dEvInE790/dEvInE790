// Lets Cloudflare Workers (Git-connected builds) serve Hiqmoh's site.
// The invitation is taken offline: only offline/ (a plain "not available" page) is published.
// To bring it back, change the directory below to "./come-over" and push.
// Cloudflare Pages ignores this file (it has no pages_build_output_dir) and
// uses the dashboard's "build output directory" setting (come-over) instead.
{
  "name": "for-hiqmoh",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./offline"
  }
}
